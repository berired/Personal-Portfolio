# ── Contact form (api/send-email.js) ───────────────────────────────────
# Resend API key. Sign up free at https://resend.com — 3,000 emails/month,
# 100/day, no card required.
#
# Register the Resend account with the SAME address you want messages sent
# to. The default sender (onboarding@resend.dev) is Resend's shared domain,
# which may only deliver to the account owner's own address — which is
# exactly what a contact form needs, so no custom domain is required.
#
# SERVER-ONLY: no VITE_ prefix, so this is never inlined into the browser
# bundle. This key can send mail as you, so it must not reach the client.
# Set it in Vercel → Project → Settings → Environment Variables too.
RESEND_API_KEY=re_your_api_key_here

# Optional overrides. If unset, mail falls back to CONTACT_TO's code default
# (davidxanderwagan@gmail.com) sent from Resend's shared sandbox sender.
#
# davidwagan.online is verified in Resend, so delivery routes to the inbox
# below instead — CONTACT_FROM must be on that same verified domain, or
# Resend will 403.
CONTACT_TO=EMAIL_ADDRESS_HERE
CONTACT_FROM="Portfolio Contact <EMAIL_ADDRESS_HERE>"

# ── RedBot chatbot (api/chat.js) ───────────────────────────────────────
# Gemini API key. Free tier at https://aistudio.google.com/apikey — no card
# required.
#
# SERVER-ONLY: no VITE_ prefix, so this is never inlined into the browser
# bundle. Set it in Vercel → Project → Settings → Environment Variables too.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional override — defaults to gemini-3.5-flash, a free-tier model.
GEMINI_MODEL=gemini-3.5-flash
